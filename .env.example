# Copy to .env (next to manage.py) and fill in real values.
# Wrap values in single quotes so $ and spaces are kept literally.
SECRET_KEY='change-me'
# True/False. Live site currently runs with True; switch to False separately and test static/media.
DEBUG=False
# Comma-separated, e.g. studiomohar.ca,www.studiomohar.ca
ALLOWED_HOSTS=*

EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''

STRIPE_SECRET_KEY=''
