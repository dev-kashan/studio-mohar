# Copy to .env (next to manage.py) and fill in real values.
# Wrap values in single quotes so $ and spaces are kept literally.
SECRET_KEY='change-me'
# True/False. Live site currently runs with True; switch to False separately and test static/media.
DEBUG=False
# Comma-separated. Keep BOTH addresses: the www one must reach Django so it can be
# redirected to studiomohar.ca (shop/middleware.py).
ALLOWED_HOSTS=studiomohar.ca,www.studiomohar.ca,127.0.0.1,localhost

EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''

STRIPE_SECRET_KEY=''
